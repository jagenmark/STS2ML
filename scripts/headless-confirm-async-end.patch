+    private void WaitForNativeCombatEnd(Player player, CombatRoom room)
+    {
+        _syncCtx.Pump();
+        if (room.IsPreFinished || CombatManager.Instance.IsInProgress || player.Creature?.IsDead == true) return;
+        // EndCombatInternal can yield between clearing IsInProgress and MarkPreFinished.
+        // Only the native marker can unlock rewards or advance a boss.
+        var deadline = Environment.TickCount64 + 1000;
+        while (!room.IsPreFinished && player.Creature?.IsDead != true && Environment.TickCount64 < deadline)
+        {
+            Thread.Sleep(1);
+            _syncCtx.Pump();
+        }
+    }
